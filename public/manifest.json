{
  "manifest_version": 3,
  "name": "Universal Lyrics Pro",
  "version": "2.0.0",
  "description": "AI-powered real-time synchronized lyrics & Hinglish translations for Spotify, YouTube, and JioSaavn.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://*.spotify.com/*",
    "*://*.youtube.com/*",
    "*://*.jiosaavn.com/*",
    "https://lrclib.net/*",
    "https://newuniversal-lyrics-pro.vercel.app/*"
  ],
  "action": {
    "default_title": "Universal Lyrics Pro",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.spotify.com/*",
        "*://*.youtube.com/*",
        "*://*.jiosaavn.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
